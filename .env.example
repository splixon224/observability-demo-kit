# observability-demo-kit — Environment Variables
# Salin file ini menjadi .env sebelum `docker compose up`:
#   cp .env.example .env
# Lalu GANTI password di bawah dengan nilai produksi sendiri.
# JANGAN commit file .env (sudah di .gitignore).

# OpenObserve root credentials (dipakai observe service).
# ZO_ROOT_USER_EMAIL WAJIB format email valid.
# ZO_ROOT_USER_PASSWORD: min 8 char, wajib lowercase + UPPERCASE + digit + special.
ZO_ROOT_USER_EMAIL=root@example.com
ZO_ROOT_USER_PASSWORD=CHANGE_ME_Str0ng!

# Basic auth header untuk OTel collector → OpenObserve (user:pass, base64).
# Contoh untuk kredensial di atas: root@example.com:CHANGE_ME_Str0ng!
# Regenerate: echo -n 'user:pass' | base64
OBSERVE_AUTH=CHANGE_ME_BASE64
